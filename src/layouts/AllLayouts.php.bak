					top: 0;
					left: 0;
					right: 0;
					bottom: 0;
					background: rgba(255, 255, 255, 0.85);
					z-index: 100;
					align-items: center;
					justify-content: center;
					flex-direction: column;
				}
				.shopglut-module-card-new .module-loading-spinner {
					width: 40px;
