									<button type="button" class="module-link shopglut-update-plugin"
										data-slug="<?php echo esc_attr( $module_key ); ?>"
										data-basename="<?php echo esc_attr( $plugin_info['basename'] ); ?>"
										data-zip="<?php echo esc_url( $version_info['zip_url'] ); ?>"
